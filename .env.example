# Database
DATABASE_URL=sqlite+aiosqlite:///./data/immo.db

# Backend
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Scraping
SCRAPE_INTERVAL_HOURS=6
SCRAPE_DEFAULT_CITY=bari
SCRAPE_DEFAULT_LISTING_TYPE=sale
SCRAPE_IMMOBILIARE_ENABLED=true
SCRAPE_IDEALISTA_ENABLED=false  # DataDome blocks all paths
SCRAPE_CASA_ENABLED=true
SCRAPE_TECNOCASA_ENABLED=true
SCRAPE_REMAX_ENABLED=true
SCRAPE_GABETTI_ENABLED=true
SCRAPE_VISTOCASA_ENABLED=true
SCRAPE_RATE_LIMIT_RPM=20
SCRAPE_REQUEST_DELAY_MIN=2.0
SCRAPE_REQUEST_DELAY_MAX=5.0

# Deduplication
DEDUP_THRESHOLD=0.85
LISTING_INACTIVE_DAYS=14

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
