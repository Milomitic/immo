# Database
DATABASE_URL=sqlite+aiosqlite:///./data/immo.db

# Backend
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Scraping
# Periodic scans are opt-in: set to true to let the backend start a scan
# whenever the last one is older than SCRAPE_INTERVAL_HOURS.
SCRAPE_SCHEDULE_ENABLED=false
SCRAPE_INTERVAL_HOURS=6
SCRAPE_DEFAULT_CITY=bari
SCRAPE_DEFAULT_LISTING_TYPE=sale
SCRAPE_IMMOBILIARE_ENABLED=true
SCRAPE_IDEALISTA_ENABLED=false  # DataDome blocks all paths
SCRAPE_CASA_ENABLED=true
SCRAPE_TECNOCASA_ENABLED=true
SCRAPE_REMAX_ENABLED=true
SCRAPE_GABETTI_ENABLED=true
SCRAPE_VISTOCASA_ENABLED=true
SCRAPE_RATE_LIMIT_RPM=20
SCRAPE_REQUEST_DELAY_MIN=2.0
SCRAPE_REQUEST_DELAY_MAX=5.0

# Deduplication
DEDUP_THRESHOLD=0.85
LISTING_INACTIVE_DAYS=14

# Optional guard for mutating endpoints (scan trigger, favorites, saved
# searches): clients must send X-Admin-Token. Empty = open (local use).
ADMIN_TOKEN=

# Saved-search e-mail digest after each scan (optional: nothing is sent
# unless SMTP_HOST and ALERT_EMAIL_TO are set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
ALERT_EMAIL_TO=
FRONTEND_URL=http://localhost:3000

# Observability: Prometheus metrics at /metrics (disable if the API is
# public), and optional Sentry error reporting for the API and the scraper.
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match ADMIN_TOKEN when that is set.
NEXT_PUBLIC_ADMIN_TOKEN=
